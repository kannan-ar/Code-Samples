{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning"
    }
  },
  "Migration": {
    "SourceConnectionString": "Server=source-server;Database=SourceDb;Integrated Security=true;TrustServerCertificate=true;",
    "DestinationConnectionString": "Server=dest-server;Database=DestDb;Integrated Security=true;TrustServerCertificate=true;",
    "SourceQuery": "SELECT * FROM SourceTable",
    "DestinationTable": "DestinationTable",
    "BatchSize": 1000,
    "MaxRetryAttempts": 3,
    "RetryDelayMs": 500
  }
}
